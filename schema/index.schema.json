{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ABOYrbx/home-assistant-kiosk-extensions/main/schema/index.schema.json",
  "title": "Home Assistant Kiosk extension catalog index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "extensions"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "extensions": {
      "type": "array",
      "maxItems": 500,
      "items": {"$ref": "#/$defs/CatalogEntry"}
    }
  },
  "$defs": {
    "CatalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "api_version",
        "min_app_version",
        "description",
        "author",
        "license",
        "provides",
        "package_url",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/ExtensionId"},
        "name": {"type": "string", "minLength": 1},
        "version": {"$ref": "#/$defs/Semver"},
        "api_version": {"const": 1},
        "min_app_version": {"$ref": "#/$defs/Semver"},
        "description": {"type": "string", "minLength": 1, "maxLength": 2000},
        "author": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "homepage": {"type": ["string", "null"], "format": "uri", "pattern": "^https?://"},
        "provides": {"enum": ["departures", "list", "key_value"]},
        "permissions": {"$ref": "#/$defs/Permissions"},
        "config_schema": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/ConfigField"}
        },
        "package_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 5242880}
      }
    },
    "ExtensionId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
    },
    "Semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "Permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "http_hosts": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/HttpHost"}
        },
        "ha_entities": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z_]+\\.[a-z0-9_]+$"}
        }
      }
    },
    "HttpHost": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*(?::[1-9][0-9]{0,4})?$"
    },
    "ConfigField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "type"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "label": {"type": "string", "minLength": 1},
        "type": {"enum": ["string", "integer", "boolean", "url", "secret", "entity_id", "select"]},
        "required": {"type": "boolean", "default": false},
        "help": {"type": ["string", "null"]},
        "default": {},
        "min": {"type": ["integer", "null"]},
        "max": {"type": ["integer", "null"]},
        "options": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "select"}}, "required": ["type"]},
          "then": {"required": ["options"], "properties": {"options": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"type": {"const": "secret"}}, "required": ["type"]},
          "then": {"properties": {"default": {"type": "null"}}}
        }
      ]
    }
  }
}
